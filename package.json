{
  "name": "bunyi-kata",
  "private": true,
  "version": "1.0.0",
  "description": "Bunyi Kata - aplikasi pembelajaran interaktif Bahasa Melayu (PWA + Firebase + Express).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "vite build",
    "preview": "node server.js",
    "clean": "node -e \"const fs = require('fs'); if (fs.existsSync('dist')) fs.rmSync('dist', { recursive: true, force: true });\"",
    "lint": "echo 'No lint step required'",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "encode-sa": "node scripts/encode-service-account.mjs",
    "check-admin": "node scripts/check-admin-setup.mjs",
    "backup": "node scripts/backup-rtdb.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.12.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.3.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-fetch": "^2.7.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "uisfx": "^0.4.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-tools": "^15.30.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
