# GEMINI_API_KEY: Diperlukan untuk panggilan AI Gemini (jika berkaitan)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL tempat applet ini dihoskan
APP_URL="http://localhost:5173"

# ==============================================================================
# FIREBASE CONFIGURATION (PANGKALAN DATA BUNYI KATA - BUNYI-KATA-OFFICIAL)
# ==============================================================================
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
# ==============================================================================
# MOD ADMIN (PELAYAN SAHAJA)
# ==============================================================================
# AMARAN: JANGAN beri prefix VITE_ pada ADMIN_CODE. Pemboleh ubah VITE_ akan
# dibundelkan ke dalam JavaScript pelayar dan boleh dibaca sesiapa melalui
# DevTools. Kod admin mesti kekal di pelayan sahaja.
#
# Kod ini ditaip dalam kotak kod biasa (tiada butang admin khas), dihantar ke
# POST /api/admin/verify, dan pelayan memulangkan Firebase custom token.
# Gunakan sesuatu yang panjang & sukar diteka — bukan "ADMIN".
ADMIN_CODE=pilih-kod-admin-yang-panjang-dan-rahsia

# UID yang akan digunakan untuk sesi admin. Kekalkan nilai yang sama supaya
# rekod audit konsisten.
ADMIN_UID=bunyikata-admin

# ==============================================================================
# FIREBASE ADMIN SDK (PELAYAN SAHAJA)
# ==============================================================================
# Diperlukan untuk menjana custom token admin.
# Dapatkan dari: Firebase Console > Project Settings > Service accounts >
#                Generate new private key
#
# Tampalkan keseluruhan JSON dalam SATU baris, atau kodkan sebagai base64.
# JANGAN commit fail kunci itu ke dalam git.
FIREBASE_SERVICE_ACCOUNT=

# Pilihan: jika FIREBASE_SERVICE_ACCOUNT dibiarkan kosong (cth. semasa berjalan
# di Cloud Functions / Cloud Run), Application Default Credentials akan diguna.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app


